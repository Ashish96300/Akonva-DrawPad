{
  "name": "drawpad-desktop",
  "version": "1.0.0",
  "description": "Wireless drawing tablet receiver for mobile devices.",
  "author": "Ashish Sen",
  "license": "ISC",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win"
  },
  "dependencies": {
    "@nut-tree-fork/nut-js": "^4.2.6",
    "dotenv": "^17.4.0",
    "express": "^5.2.1",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "ws": "^8.20.0"
  },
  "devDependencies": {
    "electron": "^41.0.2",
    "electron-builder": "^26.8.1"
  },
  "build": {
    "win": {
      "target": "nsis",
      "signAndEditExecutable": false
    },
    "appId": "com.ashish96300.drawpad",
    "productName": "DrawPad",
    "asarUnpack": [
      "node_modules/@nut-tree-fork/**/*"
    ],
    "nsis": {
      "oneClick": true,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true
    }
  }
}
